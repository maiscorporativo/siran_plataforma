# SIRAN — Plataforma do Associado
# Copie para .env e preencha.

# ── Banco de Dados MySQL ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=siran_plataforma

# ── Servidor ────────────────────────────────────────────────────
# Hostinger define PORT automaticamente, não altere em produção
PORT=3002
NODE_ENV=development

# ── Arquivos enviados ───────────────────────────────────────────
# Caminho ABSOLUTO, FORA da área de deploy, para que novas implantações
# não apaguem documentos, boletos e fotos. Dentro dele são criadas:
#   publico/  → fotos de anúncios e logos de conveniados (servidos em /uploads)
#   privado/  → documentos dos associados, boletos e ofícios (só com login)
# Ex (Hostinger): STORAGE_DIR=/home/uXXXXXXXX/domains/associado.siran.com.br/storage
# Se vazio, usa ./storage (desenvolvimento).
# STORAGE_DIR=

# ── Primeiro acesso da equipe ───────────────────────────────────
# Usado só quando não existe nenhum usuário administrativo no banco.
# Troque a senha no primeiro login.
ADMIN_MASTER_EMAIL=admin@siran.com.br
ADMIN_MASTER_PASSWORD=troque-esta-senha

# ── Endereço público (links nos avisos e recuperação de senha) ──
# Obrigatório para a recuperação de senha funcionar.
# APP_URL=https://associado.siran.com.br
# TZ=America/Sao_Paulo

# ── E-mail (SMTP) — opcional ────────────────────────────────────
# Gmail exige "senha de app". Hostinger: smtp.hostinger.com porta 465 (SSL).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="SIRAN - Área do Associado <email@dominio>"

# ── WhatsApp (Evolution API) — opcional ─────────────────────────
# EVOLUTION_API_URL=https://evolution.seudominio.com.br
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# Intervalo entre mensagens de WhatsApp (ms). Padrão 4000.
# WHATSAPP_INTERVALO_MS=4000
